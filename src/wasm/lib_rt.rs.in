//! rupy_lib.wasm: rupy's packages implemented in Rust (numpy, sklearn, torch,
//! ...), for programs compiled by rupy's wasm backend. Generated by
//! `rupy wasm-lib`; see rupy's `src/wasm/bridge.rs` for the protocol.

mod wrappers;

use rupy::pyrt::PyErr;
use std::any::Any;
use std::cell::RefCell;

/// Package objects the program holds, by handle.
#[derive(Default)]
pub struct Handles {
    objs: Vec<Option<Box<dyn Any>>>,
    free: Vec<usize>,
}

fn type_error(msg: String) -> PyErr {
    PyErr::new(&["TypeError", "Exception", "BaseException"], &msg)
}

impl Handles {
    pub fn get<T: Any>(&self, id: i64) -> Result<&T, PyErr> {
        self.objs
            .get(id as usize)
            .and_then(|o| o.as_ref())
            .and_then(|o| o.downcast_ref::<T>())
            .ok_or_else(|| type_error(format!("rupy_lib: handle {} is not a {}", id, std::any::type_name::<T>())))
    }
    pub fn put<T: Any>(&mut self, x: T) -> i64 {
        match self.free.pop() {
            Some(i) => {
                self.objs[i] = Some(Box::new(x));
                i as i64
            }
            None => {
                self.objs.push(Some(Box::new(x)));
                (self.objs.len() - 1) as i64
            }
        }
    }
    pub fn take<T: Any>(&mut self, id: i64) -> Result<T, PyErr> {
        let slot = self.objs.get_mut(id as usize).ok_or_else(|| type_error(format!("rupy_lib: no handle {}", id)))?;
        match slot.take().map(|o| o.downcast::<T>()) {
            Some(Ok(b)) => Ok(*b),
            Some(Err(o)) => {
                *slot = Some(o);
                Err(type_error(format!("rupy_lib: handle {} is not a {}", id, std::any::type_name::<T>())))
            }
            None => Err(type_error(format!("rupy_lib: handle {} is in use", id))),
        }
    }
    pub fn set<T: Any>(&mut self, id: i64, x: T) {
        self.objs[id as usize] = Some(Box::new(x));
    }
    fn drop_handle(&mut self, id: usize) {
        if let Some(o) = self.objs.get_mut(id) {
            if o.take().is_some() {
                self.free.push(id);
            }
        }
    }
}

/// Tokens of a request.
pub struct Dec<'a> {
    b: &'a [u8],
    at: usize,
}

impl Dec<'_> {
    fn bytes(&mut self, n: usize) -> Result<&[u8], PyErr> {
        if self.at + n > self.b.len() {
            return Err(type_error("rupy_lib: the arguments end too early".into()));
        }
        self.at += n;
        Ok(&self.b[self.at - n..self.at])
    }
    fn tag(&mut self, t: u8) -> Result<(), PyErr> {
        let got = self.bytes(1)?[0];
        if got != t {
            return Err(type_error(format!("rupy_lib: expected argument {:?}, got {:?}", t as char, got as char)));
        }
        Ok(())
    }
    pub fn int(&mut self) -> Result<i64, PyErr> {
        self.tag(b'i')?;
        Ok(i64::from_le_bytes(self.bytes(8)?.try_into().unwrap()))
    }
    pub fn float(&mut self) -> Result<f64, PyErr> {
        self.tag(b'f')?;
        Ok(f64::from_le_bytes(self.bytes(8)?.try_into().unwrap()))
    }
    pub fn str(&mut self) -> Result<String, PyErr> {
        self.tag(b's')?;
        let n = u32::from_le_bytes(self.bytes(4)?.try_into().unwrap()) as usize;
        Ok(String::from_utf8_lossy(self.bytes(n)?).into_owned())
    }
    fn done(&self) -> bool {
        self.at >= self.b.len()
    }
}

/// Tokens of a result.
#[derive(Default)]
pub struct Enc {
    pub b: Vec<u8>,
}

impl Enc {
    pub fn int(&mut self, x: i64) {
        self.b.push(b'i');
        self.b.extend_from_slice(&x.to_le_bytes());
    }
    pub fn float(&mut self, x: f64) {
        self.b.push(b'f');
        self.b.extend_from_slice(&x.to_le_bytes());
    }
    pub fn str(&mut self, s: &str) {
        self.b.push(b's');
        self.b.extend_from_slice(&(s.len() as u32).to_le_bytes());
        self.b.extend_from_slice(s.as_bytes());
    }
}

include!("dispatch.rs");

/// `@index`: a numpy-style index from its tagged parts (front's `index_arg`).
fn index(d: &mut Dec, e: &mut Enc, h: &mut Handles) -> Result<(), PyErr> {
    use rupy::pyrt::Ix;
    let opt = |d: &mut Dec| -> Result<Option<i64>, PyErr> { Ok(if d.int()? != 0 { Some(d.int()?) } else { None }) };
    let mut parts = vec![];
    while !d.done() {
        let tag = d.str()?;
        parts.push(match tag.as_str() {
            "s" => {
                let (lo, hi, st) = (opt(d)?, opt(d)?, opt(d)?);
                Ix::Slice(lo, hi, st)
            }
            "n" => Ix::NewAxis,
            "e" => Ix::Ellipsis,
            "i" => Ix::Int(d.int()?),
            "l" => {
                let n = d.int()? as usize;
                Ix::Ints((0..n).map(|_| d.int()).collect::<Result<_, _>>()?)
            }
            "m" => {
                let n = d.int()? as usize;
                Ix::Bools((0..n).map(|_| Ok(d.int()? != 0)).collect::<Result<_, PyErr>>()?)
            }
            _ => {
                // an array (or tensor) used as an index
                let id = d.int()?;
                index_obj(h, id)?
            }
        });
    }
    e.int(h.put(rupy::pyrt::Index(parts)));
    Ok(())
}

thread_local! {
    static HANDLES: RefCell<Handles> = RefCell::new(Handles::default());
    static INPUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
    static OUTPUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
}

/// A buffer of `n` bytes for the next request.
#[no_mangle]
pub extern "C" fn rl_alloc(n: usize) -> *mut u8 {
    INPUT.with(|i| {
        let mut i = i.borrow_mut();
        i.clear();
        i.resize(n, 0);
        i.as_mut_ptr()
    })
}

/// Run the request in the input buffer (`[key length u32][key][tokens]`):
/// 0 and the result tokens, or 1 and the exception's kind and message.
#[no_mangle]
pub extern "C" fn rl_call() -> u32 {
    let input = INPUT.with(|i| std::mem::take(&mut *i.borrow_mut()));
    let n = u32::from_le_bytes(input[..4].try_into().unwrap()) as usize;
    let key = String::from_utf8_lossy(&input[4..4 + n]).into_owned();
    let mut d = Dec { b: &input[4 + n..], at: 0 };
    let mut e = Enc::default();
    let r = HANDLES.with(|h| dispatch(&key, &mut d, &mut e, &mut h.borrow_mut()));
    let (status, out) = match r {
        Ok(()) => (0, e.b),
        Err(err) => {
            let mut e = Enc::default();
            e.str(&err.chain.join(","));
            e.str(&err.msg);
            (1, e.b)
        }
    };
    OUTPUT.with(|o| *o.borrow_mut() = out);
    status
}

#[no_mangle]
pub extern "C" fn rl_out_ptr() -> *const u8 {
    OUTPUT.with(|o| o.borrow().as_ptr())
}

#[no_mangle]
pub extern "C" fn rl_out_len() -> usize {
    OUTPUT.with(|o| o.borrow().len())
}

/// The program no longer holds handle `id`.
#[no_mangle]
pub extern "C" fn rl_drop(id: u32) {
    HANDLES.with(|h| h.borrow_mut().drop_handle(id as usize));
}
