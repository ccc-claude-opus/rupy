// rupy IDE：在瀏覽器裡編譯並執行 rupy（rupy.wasm）；伺服器放帳號、檔案（D1 + R2）與分享連結
// cp .dev.vars.example .dev.vars（填 AUTH_SECRET），sh ide/build.sh && rucloud dev ide
{
  "name": "rupy-ide",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/s/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "rupy-ide", "database_id": "local" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "rupy-ide-files" }]
}
